{
  "name": "roomtone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "apk:build:s24": "powershell -ExecutionPolicy Bypass -File ./scripts/android/build-s24-apk.ps1",
    "apk:install:s24": "powershell -ExecutionPolicy Bypass -File ./scripts/android/install-s24-apk.ps1",
    "apk:diagnostics:s24": "powershell -ExecutionPolicy Bypass -File ./scripts/android/collect-s24-diagnostics.ps1",
    "apk:build:eas": "npx eas-cli build --platform android --profile s24-apk",
    "typecheck": "tsc --noEmit",
    "typecheck:domain": "tsc -p tsconfig.domain.json --noEmit",
    "test": "node --test tests/domain/*.test.ts",
    "verify:repo": "node scripts/validate-repo.mjs",
    "check": "npm run verify:repo && npm run typecheck:domain && npm test && npm run typecheck && npm run typecheck:test",
    "doctor": "npx expo-doctor",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "expo": "~57.0.13",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.11",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-fs": "2.20.0",
    "react-native-safe-area-context": "~5.7.0",
    "whisper.rn": "0.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fs",
          "whisper.rn"
        ]
      }
    }
  }
}
